{
	"name": "server",
	"version": "1.0.0",
	"description": "",
	"main": "dist/main.js",
	"scripts": {
		"lint": "eslint .",
		"dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node ./dist/main.js\"",
		"build": "tsc -p tsconfig.build.json",
		"start": "node ./dist/main.js",
		"test": "vitest run",
		"test:stress": "STRESS=1 vitest run tests/concurrency.test.ts",
		"migrate:up-1": "node-pg-migrate -f ./src/database/node-pg-migrate-config-file.json up 1",
		"migrate:up": "node-pg-migrate -f ./src/database/node-pg-migrate-config-file.json up",
		"migrate:down": "node-pg-migrate -f ./src/database/node-pg-migrate-config-file.json down",
		"migrate:create": "node-pg-migrate -f ./src/database/node-pg-migrate-config-file.json create -j sql"
	},
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/module-alias": "^2.0.4",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.21.0",
		"@types/supertest": "^7.2.1",
		"eslint": "^9.13.0",
		"eslint-plugin-import": "^2.31.0",
		"globals": "^15.11.0",
		"supertest": "^7.2.2",
		"tsc-watch": "^6.3.1",
		"typescript": "^5.x",
		"typescript-eslint": "^8.11.0",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.1",
		"module-alias": "^2.2.3",
		"node-pg-migrate": "^9.0.0",
		"pg": "^8.23.0",
		"zod": "^4.4.3"
	}
}
